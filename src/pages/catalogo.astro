---
import Layout from '../layouts/Layout.astro';
import HeroInterior from '../components/HeroInterior.astro';
import LineasDeProductos from '../components/LineasDeProductos.astro';
import Separador from '../components/Separador.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import { leerCatalogo } from '../lib/almacen';

// Se arma en cada visita porque el contenido se edita desde el admin.
export const prerender = false;
const { lineas, urnas } = await leerCatalogo();
const hay = (l: typeof lineas) => l.some((x) => x.productos.length);
---

<Layout
	title="Catálogo de ataúdes y urnas · Funerales González"
	description="Ataúdes de madera, metálicos y extra ancho, y urnas para cenizas. Medidas, materiales y pedido directo por WhatsApp."
>
	<main>
		<HeroInterior
			antetitulo="Catálogo de ataúdes y urnas"
			titulo="Opciones pensadas para honrar a quien amaste, sin presión de decidir solo."
			fondo="/urna_cremacion.webp"
			enfoque="50% 35%"
		/>

		<!-- Ataúdes -->
		{hay(lineas) && (
			<section id="ataudes" class="scroll-mt-8 bg-white py-20 sm:py-24">
				<div class="mx-auto max-w-7xl px-4">
					<TituloSeccion titulo="Ataúdes" centrado />
					<LineasDeProductos lineas={lineas} tipo="ataúd" />
				</div>
			</section>
		)}

		<!-- Urnas -->
		{hay(urnas) && (
			<section id="urnas" class="relative scroll-mt-8 bg-marfil py-20 sm:py-24">
				<Separador class="absolute inset-x-0 top-0 mx-auto max-w-7xl -translate-y-1/2 px-4" />
				<div class="mx-auto max-w-7xl px-4">
					<TituloSeccion titulo="Urnas" centrado />
					<LineasDeProductos lineas={urnas} tipo="urna" />
				</div>
			</section>
		)}
	</main>
</Layout>
