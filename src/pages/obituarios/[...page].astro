---
import type { Page } from 'astro';
import Layout from '../../layouts/Layout.astro';
import HeroInterior from '../../components/HeroInterior.astro';
import Icono from '../../components/Icono.astro';
import Paginador from '../../components/Paginador.astro';
import { anio, fechaLarga, textoMisa, textoMomento, type Obituario } from '../../data/obituarios';
import { leerObituarios } from '../../lib/almacen';

// Se arma en cada visita porque los obituarios se publican desde el admin.
export const prerender = false;

// 12 por página: /obituarios, /obituarios/2, /obituarios/3...
const POR_PAGINA = 12;
const todos = await leerObituarios();
const ultima = Math.max(1, Math.ceil(todos.length / POR_PAGINA));
const actual = Astro.params.page === undefined ? 1 : Number(Astro.params.page);
// Una página que no existe (o /obituarios/1) manda a la primera.
if (Astro.params.page !== undefined && !(Number.isInteger(actual) && actual >= 2 && actual <= ultima)) return Astro.redirect('/obituarios');
const urlDe = (n: number) => (n === 1 ? '/obituarios' : `/obituarios/${n}`);
const page = {
	data: todos.slice((actual - 1) * POR_PAGINA, actual * POR_PAGINA),
	currentPage: actual,
	lastPage: ultima,
	url: { current: urlDe(actual), prev: actual > 1 ? urlDe(actual - 1) : undefined, next: actual < ultima ? urlDe(actual + 1) : undefined },
} as Page<Obituario>;
const obituarios = page.data;

const datosDelServicio = (o: Obituario) =>
	[
		{ etiqueta: 'Inicia el servicio', valor: textoMomento(o.inicio), icono: 'Clock' },
		{ etiqueta: 'Partirá', valor: textoMomento(o.partida), icono: 'CalendarClock' },
		{ etiqueta: 'Misa', valor: o.misa && textoMisa(o.misa), icono: 'Church' },
		{ etiqueta: 'Despide en', valor: o.despide, icono: 'MapPin' },
	].filter((d) => d.valor) as { etiqueta: string; valor: string; icono: 'Clock' | 'CalendarClock' | 'Church' | 'MapPin' }[];
---

<Layout
	title={page.currentPage > 1 ? `Obituarios, página ${page.currentPage} · Funerales González` : 'Obituarios · Funerales González'}
	description="Consulta horarios de misas y velaciones en las capillas de Funerales González."
>
	<main>
		<HeroInterior antetitulo="Obituarios" titulo="Consulta horarios de misas y velaciones." fondo="/fondo_hero_obituario.webp" />

		<section class="bg-white py-20 sm:py-24">
			<ul class="mx-auto grid max-w-7xl gap-6 px-4 sm:grid-cols-2 lg:grid-cols-4">
				<!-- Tarjeta: foto en gris con los datos encima y el botón pegado abajo -->
				{obituarios.map((o, i) => (
					<li class="flex flex-col overflow-hidden rounded-xl shadow-sm ring-1 ring-black/5">
						<div class:list={['relative', o.foto ? 'bg-ciruela' : 'bg-lavanda']}>
							{/* Sin foto: fondo claro con la cruz del logo (como el catálogo), arriba para no chocar con el texto */}
							{o.foto ? (
								<img src={o.foto} alt={`Fotografía de ${o.nombre}`} loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover object-top grayscale" />
							) : (
								<div class="flex aspect-[3/4] w-full justify-center pt-[12%]">
									<img src="/favicon_fg.png" alt="" width="512" height="512" loading="lazy" class="h-1/2 w-auto opacity-40" />
								</div>
							)}
							<div class:list={['absolute inset-x-0 bottom-0 px-5 pt-20 pb-5 text-center', o.foto && 'bg-linear-to-t from-black/85 via-black/60 to-transparent text-white']}>
								<h2 class:list={['text-xl leading-snug text-balance', o.foto ? 'text-white' : 'text-ciruela']}>{o.nombre}</h2>
								<p class:list={['mt-1 font-serif', o.foto ? 'text-oro-claro' : 'text-oro-oscuro']}>{anio(o.nacimiento)} – {anio(o.fallecimiento)}</p>
								<p class:list={['mt-2 text-sm', o.foto ? 'text-white/85' : 'text-tinta/80']}>{o.capilla} · {o.sala}</p>
								<p class:list={['mt-3 flex items-center justify-center gap-1.5 border-t pt-3 text-sm font-semibold', o.foto ? 'border-white/20 text-white' : 'border-ciruela/15 text-ciruela']}>
									<Icono nombre="CalendarDays" class={`size-4 shrink-0 ${o.foto ? 'text-oro-claro' : 'text-oro-oscuro'}`} />
									Servicio: {textoMomento(o.inicio)}
								</p>
							</div>
						</div>
						<button
							type="button"
							class="flex w-full items-center justify-center gap-2 bg-oro-oscuro px-4 py-3.5 font-bold text-white transition hover:bg-marca"
							data-abrir-obituario={i}
						>
							<Icono nombre="Info" class="size-5" /> Ver información completa
						</button>
					</li>
				))}
			</ul>
			<Paginador pagina={page} />
		</section>
	</main>

	<!-- Una ventana por obituario con la información completa -->
	{obituarios.map((o, i) => (
		<dialog
			class="m-auto w-[min(92vw,44rem)] overflow-hidden rounded-2xl bg-white p-0 shadow-xl backdrop:bg-ciruela/80"
			aria-label={`Información de ${o.nombre}`}
			data-obituario={i}
		>
			<div class="grid sm:grid-cols-[2fr_3fr]">
				{o.foto ? (
					<img src={o.foto} alt={`Fotografía de ${o.nombre}`} loading="lazy" decoding="async" class="aspect-[4/3] size-full object-cover object-top grayscale sm:aspect-auto" />
				) : (
					<div class="grid aspect-[4/3] size-full place-items-center bg-lavanda sm:aspect-auto">
						<img src="/favicon_fg.png" alt="" width="512" height="512" loading="lazy" class="h-32 w-auto opacity-40" />
					</div>
				)}
				<div class="relative p-6 sm:p-8">
					<button type="button" class="absolute top-3 right-3 grid size-10 place-items-center rounded-full text-ciruela hover:bg-humo" aria-label="Cerrar" data-cerrar-obituario>
						<Icono nombre="X" class="size-6" />
					</button>
					<p class="text-sm font-bold tracking-[0.2em] text-oro-oscuro uppercase">En memoria de</p>
					<h2 class="mt-2 pr-8 text-2xl leading-snug text-balance">{o.nombre}</h2>
					<p class="mt-1 font-serif text-lg text-oro-oscuro">{fechaLarga(o.nacimiento)} – {fechaLarga(o.fallecimiento)}</p>
					<p class="mt-3 flex items-center gap-2 text-tinta/85">
						<Icono nombre="Building2" class="size-5 shrink-0 text-oro-oscuro" />
						{o.capilla} · {o.sala}
					</p>
					{o.ubicacion && (
						<a
							href={o.ubicacion}
							target="_blank"
							rel="noopener"
							class="mt-4 inline-flex items-center gap-2 rounded-md bg-oro-oscuro px-4 py-2.5 text-sm font-bold text-white transition hover:bg-marca"
						>
							<Icono nombre="Map" class="size-4" /> Ver ubicación
						</a>
					)}

					<dl class="mt-6 space-y-4 border-t border-black/10 pt-6">
						{datosDelServicio(o).map((d) => (
							<div class="flex gap-3">
								<Icono nombre={d.icono} class="mt-0.5 size-5 shrink-0 text-oro-oscuro" />
								<div>
									<dt class="text-xs font-bold tracking-wider text-marca uppercase">{d.etiqueta}</dt>
									<dd class="mt-0.5 text-tinta">{d.valor}</dd>
								</div>
							</div>
						))}
					</dl>
				</div>
			</div>
		</dialog>
	))}
</Layout>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-abrir-obituario]').forEach((boton) =>
		boton.addEventListener('click', () => {
			document.querySelector<HTMLDialogElement>(`[data-obituario="${boton.dataset.abrirObituario}"]`)?.showModal();
		}),
	);
	document.querySelectorAll<HTMLDialogElement>('[data-obituario]').forEach((dialogo) => {
		dialogo.querySelector('[data-cerrar-obituario]')?.addEventListener('click', () => dialogo.close());
		// Cerrar al tocar fuera de la ventana
		dialogo.addEventListener('click', (e) => {
			if (e.target === dialogo) dialogo.close();
		});
	});
</script>
