---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icono from '../../components/Icono.astro';
import { adminConfigurado, contrasenaCorrecta, iniciarSesion, sesionValida } from '../../lib/sesion';

export const prerender = false;

if (sesionValida(Astro.cookies)) return Astro.redirect('/admin/catalogo');

let error = '';
if (Astro.request.method === 'POST') {
	const datos = await Astro.request.formData();
	if (contrasenaCorrecta(String(datos.get('contrasena') ?? ''))) {
		iniciarSesion(Astro.cookies);
		return Astro.redirect('/admin/catalogo', 303);
	}
	// Una pausa corta hace más lento probar contraseñas al azar.
	await new Promise((r) => setTimeout(r, 1000));
	error = 'La contraseña no es correcta.';
}
---

<AdminLayout title="Entrar">
	<main class="grid place-items-center px-4 py-20">
		<form method="post" class="w-full max-w-sm rounded-2xl bg-white p-8 shadow-sm ring-1 ring-black/5">
			<span class="grid size-12 place-items-center rounded-full bg-oro-oscuro text-white">
				<Icono nombre="Lock" class="size-6" />
			</span>
			<h1 class="mt-5 text-2xl">Entrar al administrador</h1>
			{adminConfigurado() ? (
				<>
					<p class="mt-2 text-sm text-tinta/80">Aquí puedes editar el catálogo de ataúdes y urnas y las flores.</p>
					<label class="mt-6 grid gap-1.5 text-sm font-semibold text-ciruela">
						Contraseña
						<input
							name="contrasena"
							type="password"
							required
							autofocus
							autocomplete="current-password"
							class="rounded-md border border-black/15 bg-white px-3 py-2.5 font-normal text-tinta focus:border-oro-oscuro focus:outline-none"
						/>
					</label>
					{error && <p class="mt-3 text-sm font-semibold text-oro-oscuro" role="alert">{error}</p>}
					<button type="submit" class="mt-6 w-full rounded-md bg-marca px-4 py-3 font-bold text-white transition hover:bg-oro-oscuro">Entrar</button>
				</>
			) : (
				<p class="mt-3 text-sm text-tinta/80">
					Falta configurar la contraseña del admin: agrega la variable <code class="font-bold">ADMIN_PASSWORD</code> al archivo
					<code class="font-bold">.env</code> (en local) o a las variables de entorno del proyecto en Vercel.
				</p>
			)}
		</form>
	</main>
</AdminLayout>
