---
import Layout from '../layouts/Layout.astro';
import CuadroDesde1945 from '../components/CuadroDesde1945.astro';
import HeroInterior from '../components/HeroInterior.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import Sucursales from '../components/inicio/Sucursales.astro';

// Pendientes del cliente (documento de contenido): línea de tiempo 1945 → hoy con hitos,
// y fotografías de las instalaciones (Matriz Mitras/Colón, Montemorelos, Oratorio, Sabinas).
---

<Layout
	title="Nosotros · Funerales González"
	description="Desde 1945, tres generaciones de la familia González acompañan a las familias de Nuevo León con cercanía, respeto y profesionalismo."
>
	<main>
		<HeroInterior antetitulo="Nosotros" titulo="Esta es nuestra historia, pero también la de cada familia que hemos acompañado" />

		<section class="bg-white py-20 sm:py-24">
			<div class="mx-auto grid max-w-7xl items-center gap-12 px-4 lg:grid-cols-[3fr_2fr] lg:gap-20">
				<TituloSeccion antetitulo="Nuestra historia" titulo="Más de 80 años de historia, un mismo compromiso">
					<p class="mt-5 text-lg text-tinta/85">
						Desde 1945, Funerales González ha sido un pilar de acompañamiento para las familias de Nuevo León. Durante más de 80 años, tres generaciones de la familia González han sostenido esta labor con el mismo compromiso: brindar cercanía, respeto y profesionalismo en los momentos más sensibles de la vida.
					</p>
					<p class="mt-4 text-lg text-tinta/85">
						Contamos con instalaciones propias, personal capacitado y capacidad para atender desde servicios inmediatos hasta planes de previsión a futuro, siempre con la certeza de una institución consolidada.
					</p>
				</TituloSeccion>
				<CuadroDesde1945 />
			</div>
		</section>

		<Sucursales />
	</main>
</Layout>
