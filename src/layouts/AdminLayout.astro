---
// Layout del admin: misma identidad que el sitio (franja ciruela, logo, tipografías y tokens), con su propio menú.
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-color.webp';
import logoBlanco from '../assets/brand/logo-blanco.webp';
import Icono from '../components/Icono.astro';
import { sitio } from '../data/sitio';

interface Props {
	title: string;
	/** Mensaje tras guardar ("Cambios guardados") o de error. */
	aviso?: { tipo: 'ok' | 'error'; texto: string };
}

const { title, aviso } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/$/, '');
const menu = [
	{ href: '/admin/catalogo', texto: 'Catálogo de ataúdes y urnas' },
	{ href: '/admin/flores', texto: 'Flores' },
	{ href: '/admin/obituarios', texto: 'Obituarios' },
];
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#081b1e" />
		<title>{title} · Admin Funerales González</title>
	</head>
	<body class="min-h-screen antialiased">
		<header>
			<div class="bg-franja text-sm text-white">
				<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2">
					<p class="font-bold tracking-wide">Panel de administración</p>
					{menu.some((m) => m.href === ruta) && (
						<a href="/admin/salir" class="flex items-center gap-1.5 text-white/90 hover:text-white">
							<Icono nombre="LogOut" class="size-4" /> Salir
						</a>
					)}
				</div>
			</div>
			<div class="bg-white shadow-sm">
				<!-- En celular y tableta el menú se abre con el botón de hamburguesa, en su propia fila bajo el logo -->
				<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 px-4 py-3">
					<a href="/admin" aria-label="Ir al inicio del admin">
						<Image src={logo} alt="Funerales González" class="h-16 w-auto" loading="eager" />
					</a>
					{menu.some((m) => m.href === ruta) && (
						<>
							<button
								type="button"
								class="ml-auto grid size-11 place-items-center rounded-md text-ciruela hover:bg-humo lg:hidden"
								aria-controls="menu-admin"
								aria-expanded="false"
								data-menu-boton
							>
								<span class="sr-only">Abrir menú</span>
								<span data-icono-abrir><Icono nombre="Menu" class="size-7" /></span>
								<span class="hidden" data-icono-cerrar><Icono nombre="X" class="size-7" /></span>
							</button>
							<nav
								id="menu-admin"
								class="mt-3 hidden basis-full flex-col gap-1 border-t border-black/5 pt-3 data-abierto:flex lg:mt-0 lg:flex lg:flex-1 lg:basis-0 lg:flex-row lg:items-center lg:justify-end lg:gap-2 lg:border-0 lg:pt-0"
								aria-label="Secciones del admin"
								data-menu-panel
							>
								{menu.map((m) => (
									<a
										href={m.href}
										aria-current={m.href === ruta ? 'page' : undefined}
										class:list={[
											'rounded-md px-4 py-3 text-lg font-bold transition lg:py-2.5 lg:text-base',
											m.href === ruta ? 'bg-marca text-white' : 'text-ciruela hover:bg-humo',
										]}
									>
										{m.texto}
									</a>
								))}
							</nav>
						</>
					)}
				</div>
			</div>
		</header>

		{aviso && (
			<div
				role={aviso.tipo === 'error' ? 'alert' : 'status'}
				class:list={[
					'fixed inset-x-4 bottom-6 z-50 mx-auto flex max-w-md items-center gap-3 rounded-xl px-5 py-4 font-semibold text-white shadow-xl transition-opacity duration-500',
					aviso.tipo === 'ok' ? 'bg-whatsapp' : 'bg-ciruela',
				]}
				data-aviso
			>
				<Icono nombre={aviso.tipo === 'ok' ? 'CircleCheck' : 'CircleAlert'} class="size-6 shrink-0" />
				{aviso.texto}
			</div>
		)}

		<slot />

		<!-- Pie del sitio sin contacto, menú ni aviso de privacidad: mismo acomodo, solo logo y razón social -->
		<footer class="bg-pie text-white/80">
			<div class="mx-auto flex max-w-7xl justify-center px-4 py-12 lg:justify-start">
				<Image src={logoBlanco} alt={`${sitio.nombre}, desde 1945`} class="h-auto w-56" />
			</div>
			<div class="border-t border-white/10">
				<div class="mx-auto max-w-7xl px-4 py-6 text-xs text-white/60">
					<p>© {new Date().getFullYear()} {sitio.razonSocial}</p>
				</div>
			</div>
		</footer>

		<script>
			// El aviso se oculta solo y se quita "?aviso=" de la URL para que no reaparezca al recargar.
			const aviso = document.querySelector<HTMLElement>('[data-aviso]');
			if (aviso) setTimeout(() => aviso.classList.add('opacity-0', 'pointer-events-none'), 4000);
			const url = new URL(location.href);
			// Menú de hamburguesa (celular y tableta).
			const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
			const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
			boton?.addEventListener('click', () => {
				const abierto = boton.getAttribute('aria-expanded') === 'true';
				boton.setAttribute('aria-expanded', String(!abierto));
				boton.querySelector('.sr-only')!.textContent = abierto ? 'Abrir menú' : 'Cerrar menú';
				boton.querySelector('[data-icono-abrir]')?.classList.toggle('hidden', !abierto);
				boton.querySelector('[data-icono-cerrar]')?.classList.toggle('hidden', abierto);
				panel?.toggleAttribute('data-abierto', !abierto);
			});
			if (url.searchParams.has('aviso')) {
				url.searchParams.delete('aviso');
				history.replaceState(null, '', url);
			}
		</script>
	</body>
</html>
