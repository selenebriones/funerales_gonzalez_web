---
import Icono from './Icono.astro';
import IconoWhatsApp from './IconoWhatsApp.astro';
import { sitio } from '../data/sitio';
---

<!-- Contacto inmediato flotante en móvil: llamar a la izquierda, WhatsApp a la derecha -->
<a
	href={sitio.telefono.href}
	aria-label={`Llámanos al ${sitio.telefono.mostrar}`}
	class="fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] z-50 grid size-14 place-items-center rounded-full text-white shadow-[0_4px_16px_rgb(0_0_0/0.25)] transition md:hidden left-4 bg-oro-oscuro hover:bg-marca"
>
	<Icono nombre="Phone" class="size-6" />
</a>
<a
	href={sitio.whatsapp.href}
	target="_blank"
	rel="noopener"
	aria-label="Escríbenos por WhatsApp"
	class="fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] z-50 grid size-14 place-items-center rounded-full text-white shadow-[0_4px_16px_rgb(0_0_0/0.25)] transition md:hidden right-4 bg-whatsapp hover:bg-whatsapp-oscuro"
>
	<IconoWhatsApp class="size-7" />
</a>
