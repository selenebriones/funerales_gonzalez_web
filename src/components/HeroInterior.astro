---
import { Image } from 'astro:assets';
import logoBlanco from '../assets/brand/logo-blanco.webp';

// Encabezado de las páginas interiores: café del menú (marca), oscurecido a la izquierda como su hover.
// `fondo` (opcional): imagen de public/ detrás del café, que queda como velo para que el texto se lea.
// `enfoque` (opcional): qué parte de la foto se ve al recortarla, como object-position ("50% 35%").
// `paloma` (opcional): la paloma translúcida a la derecha, solo en escritorio para no tapar el título.
// `logo` (opcional): el logotipo para fondo oscuro a la derecha, desde 1024 px (pensado para títulos cortos).
// `tresLineas` (por omisión sí): en escritorio todos los heros miden lo mismo y el título se reparte en 3 líneas;
// el ancho se calcula con el largo del título. El admin lo apaga. Un `\n` en el título fuerza el salto ahí
// y entonces se respetan esas líneas en lugar de calcular el ancho.
interface Props {
	antetitulo: string;
	titulo: string;
	fondo?: string;
	enfoque?: string;
	paloma?: boolean;
	logo?: boolean;
	tresLineas?: boolean;
}

const { antetitulo, titulo, fondo, enfoque = '50% 50%', paloma = false, logo = false, tresLineas = true } = Astro.props;

// Ancho aproximado de un tercio del título en Lora (≈0.5em por carácter), más un margen.
const anchoTitulo = `${(titulo.length / 3) * 0.5 + 2.5}em`;
const lineasTitulo = titulo.split('\n');
const calcularAncho = tresLineas && lineasTitulo.length === 1;
---

<section class="relative isolate overflow-hidden bg-marca text-white">
	{fondo && (
		<>
			<img src={fondo} alt="" fetchpriority="high" data-acercamiento class="absolute inset-0 -z-20 size-full object-cover" style={`object-position: ${enfoque}`} />
			<div class="absolute inset-0 -z-10 bg-marca/70"></div>
		</>
	)}
	<div class="absolute inset-0 -z-10 bg-linear-to-r from-black/35 via-black/15 to-transparent"></div>
	<div class:list={['relative mx-auto max-w-7xl px-4 py-16 sm:py-20', tresLineas && 'lg:flex lg:min-h-[27rem] lg:flex-col lg:justify-center']} data-entrada>
		{logo && (
			<Image
				src={logoBlanco}
				alt=""
				widths={[320, 640]}
				sizes="320px"
				class="pointer-events-none absolute top-1/2 right-4 hidden h-auto w-72 -translate-y-1/2 lg:block xl:w-80"
			/>
		)}
		{paloma && (
			<img
				src="/icono_paloma.svg"
				alt=""
				width="155"
				height="96"
				class="pointer-events-none absolute top-1/2 right-4 hidden h-auto w-80 -translate-y-1/2 opacity-60 brightness-150 xl:block"
			/>
		)}
		<p class="flex items-center gap-3 text-sm font-bold tracking-[0.25em] text-oro-claro uppercase">
			<span class="h-px w-10 bg-oro-claro/60"></span>
			{antetitulo}
		</p>
		<h1
			class:list={['mt-4 max-w-3xl text-3xl leading-tight text-balance text-white sm:text-4xl lg:text-5xl', calcularAncho && 'lg:max-w-(--ancho-titulo)']}
			style={calcularAncho ? `--ancho-titulo: ${anchoTitulo}` : undefined}
		>
			{lineasTitulo.map((linea, i) => (i > 0 ? <><br />{linea}</> : linea))}
		</h1>
		<!-- Bajada opcional -->
		<slot />
	</div>
</section>
