---
// Encabezado de las páginas interiores: café del menú (marca), oscurecido a la izquierda como su hover.
interface Props {
	antetitulo: string;
	titulo: string;
}

const { antetitulo, titulo } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-marca text-white">
	<div class="absolute inset-0 -z-10 bg-linear-to-r from-black/35 via-black/15 to-transparent"></div>
	<div class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
		<p class="flex items-center gap-3 text-sm font-bold tracking-[0.25em] text-oro-claro uppercase">
			<span class="h-px w-10 bg-oro-claro/60"></span>
			{antetitulo}
		</p>
		<h1 class="mt-4 max-w-3xl text-3xl leading-tight text-balance text-white sm:text-4xl lg:text-5xl">{titulo}</h1>
		<!-- Bajada opcional -->
		<slot />
	</div>
</section>
