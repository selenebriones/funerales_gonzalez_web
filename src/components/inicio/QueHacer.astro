---
import Icono from '../Icono.astro';
import TituloSeccion from '../TituloSeccion.astro';
import { sitio } from '../../data/sitio';

// TODO: validar el texto exacto de los pasos con el personal operativo (nota del documento de contenido).
const pasos = [
	{ titulo: 'Mantén la calma y comunícate con nosotros', texto: `Llámanos al ${sitio.telefono.mostrar} o escríbenos por WhatsApp. Estamos disponibles las 24 horas.` },
	{ titulo: 'No muevas el cuerpo', texto: 'Si el fallecimiento ocurrió en casa o en la vía pública, nosotros te guiamos sobre cuándo intervienen las autoridades.' },
	{ titulo: 'Ten a la mano las identificaciones', texto: 'Una identificación oficial de la persona fallecida y del familiar responsable.' },
	{ titulo: 'Te orientamos en los trámites', texto: 'Acta de defunción, traslados y permisos: te acompañamos en cada gestión.' },
	{ titulo: 'Elige el servicio con calma', texto: 'Te ayudamos a decidir entre inhumación o cremación y a elegir la sala de velación.' },
];
---

<section class="bg-white py-20 sm:py-24">
	<div class="mx-auto grid max-w-7xl gap-12 px-4 lg:grid-cols-[2fr_3fr] lg:gap-20">
		<div class="lg:sticky lg:top-8 lg:self-start">
			<TituloSeccion antetitulo="Guía inmediata" titulo="¿Qué hacer cuando fallece un familiar?">
				<p class="mt-5 text-lg text-marca">Sabemos que es un momento difícil. Estos son los primeros pasos; no tienes que hacerlo solo.</p>
			</TituloSeccion>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href={sitio.telefono.href} class="inline-flex items-center gap-2 rounded-md bg-oro-oscuro px-5 py-3 font-bold text-white hover:bg-marca">
					<Icono nombre="Phone" class="size-5" /> Llamar ahora
				</a>
				<a href={sitio.whatsapp.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-md px-5 py-3 font-bold text-oro-oscuro ring-1 ring-oro-oscuro/40 ring-inset hover:bg-humo">
					<Icono nombre="MessageCircle" class="size-5" /> WhatsApp
				</a>
			</div>
		</div>

		<ol class="space-y-4">
			{pasos.map((paso, i) => (
				<li class="flex gap-5 rounded-xl bg-humo p-6">
					<span class="grid size-12 shrink-0 place-items-center rounded-full bg-white font-serif text-xl font-semibold text-oro-oscuro ring-1 ring-oro/30">{i + 1}</span>
					<div>
						<h3 class="text-xl">{paso.titulo}</h3>
						<p class="mt-1.5 text-tinta/80">{paso.texto}</p>
					</div>
				</li>
			))}
		</ol>
	</div>
</section>
