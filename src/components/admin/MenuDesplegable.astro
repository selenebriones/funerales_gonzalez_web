---
// Título con una flecha a la izquierda que abre un menú para cambiar a otra línea, categoría o sección.
// Cada opción es un enlace "#id"; ScriptAdmin.astro muestra ese grupo y oculta los demás (sin JS, el enlace salta a él).
import Icono from '../Icono.astro';

interface Props {
	/** Texto del título (el grupo o la sección que se está viendo). */
	titulo: string;
	actual: string;
	opciones: { id: string; texto: string }[];
	/** "seccion": grande y centrado (Ataúdes / Urnas); "grupo": línea o categoría. */
	nivel?: 'seccion' | 'grupo';
	/** Título en gris e itálica (por ejemplo, "Sin subtítulo"). */
	apagado?: boolean;
}

const { titulo, actual, opciones, nivel = 'grupo', apagado = false } = Astro.props;
const Encabezado = nivel === 'seccion' ? 'h2' : 'h3';
---

<div class:list={['relative', nivel === 'seccion' && 'flex justify-center']} data-menu>
	<button
		type="button"
		class="group flex items-center gap-3 rounded-lg py-1 pr-2 text-left"
		aria-expanded="false"
		aria-haspopup="true"
		data-menu-boton
	>
		<span class="grid size-9 shrink-0 place-items-center rounded-full bg-oro-oscuro text-white transition group-hover:bg-marca group-aria-expanded:rotate-180">
			<Icono nombre="ChevronDown" class="size-5" />
		</span>
		<Encabezado
			class:list={[
				nivel === 'seccion' ? 'text-3xl leading-tight sm:text-4xl' : 'text-2xl sm:text-3xl',
				apagado && 'text-tinta/50 italic',
			]}
		>
			{titulo}
		</Encabezado>
	</button>
	<ul
		class:list={[
			'absolute top-full z-30 mt-2 max-h-80 w-max max-w-[min(90vw,24rem)] min-w-60 overflow-y-auto rounded-xl bg-white py-2 shadow-xl ring-1 ring-black/10',
			nivel === 'seccion' ? 'left-1/2 -translate-x-1/2' : 'left-0',
		]}
		hidden
		data-menu-lista
	>
		{opciones.map((o) => (
			<li>
				<a
					href={`#${o.id}`}
					class:list={[
						'flex items-center justify-between gap-4 px-4 py-2.5 font-semibold transition hover:bg-humo',
						o.id === actual ? 'text-oro-oscuro' : 'text-ciruela',
					]}
					aria-current={o.id === actual ? 'true' : undefined}
					data-ir-grupo={o.id}
				>
					{o.texto}
					{o.id === actual && <Icono nombre="Check" class="size-4 shrink-0" />}
				</a>
			</li>
		))}
	</ul>
</div>
