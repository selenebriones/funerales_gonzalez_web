---
// Botón para agregar algo nuevo. Pequeño y morado para un renglón (ataúd, arreglo, obituario); con `descripcion`, bloque
// sólido y más grande para una línea o categoría, que así no se confunde con agregar una tarjeta.
import Icono from '../Icono.astro';

interface Props {
	texto: string;
	dialogo: string;
	valores: Record<string, unknown>;
	/** Título de la ventana; si no se da, el mismo texto del botón. */
	titulo?: string;
	/** Línea o categoría: explicación que va bajo el texto. */
	descripcion?: string;
	class?: string;
}

const { texto, dialogo, valores, titulo = texto, descripcion, class: clase } = Astro.props;
---

{descripcion ? (
	<button
		type="button"
		class:list={[
			'flex w-full items-center gap-4 rounded-xl bg-ciruela px-6 py-5 text-left text-white shadow-md transition hover:bg-marca sm:gap-5 sm:px-8',
			clase,
		]}
		data-abrir={dialogo}
		data-titulo={titulo}
		data-valores={JSON.stringify(valores)}
	>
		<span class="grid size-12 shrink-0 place-items-center rounded-full bg-oro-claro text-ciruela">
			<Icono nombre="ListPlus" class="size-6" />
		</span>
		<span>
			<span class="block font-serif text-xl font-semibold sm:text-2xl">{texto}</span>
			<span class="mt-0.5 block text-sm text-white/80">{descripcion}</span>
		</span>
	</button>
) : (
	<button
		type="button"
		class:list={[
			'inline-flex items-center gap-1.5 rounded-md bg-ciruela px-4 py-2 text-sm font-bold text-white transition hover:bg-marca',
			clase,
		]}
		data-abrir={dialogo}
		data-titulo={titulo}
		data-valores={JSON.stringify(valores)}
	>
		<Icono nombre="Plus" class="size-4" />
		{texto}
	</button>
)}
