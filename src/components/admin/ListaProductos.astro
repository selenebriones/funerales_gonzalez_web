---
// Líneas de ataúdes o de urnas en el admin. Se ve una a la vez (`data-grupo`): su nombre con el menú para cambiar
// de línea, "Editar" (que también agrega una línea nueva a esta sección), "Agregar" a su lado y debajo los renglones.
// Solo si la sección se quedó sin líneas aparece el botón grande para crear la primera.
import Icono from '../Icono.astro';
import BotonAgregar from './BotonAgregar.astro';
import FilaAdmin from './FilaAdmin.astro';
import MenuDesplegable from './MenuDesplegable.astro';
import type { Linea } from '../../data/catalogo';
import { avisoBorrarGrupo } from '../../lib/formulario';

interface Props {
	seccion: 'ataudes' | 'urnas';
	lineas: Linea[];
}

const { seccion, lineas } = Astro.props;
const tipo = seccion === 'ataudes' ? 'ataúd' : 'urna';
const opciones = lineas.map((l) => ({ id: l.id, texto: l.linea || 'Sin subtítulo' }));
---

<div class="mt-10">
	{lineas.map((l) => (
		<div id={l.id} class="scroll-mt-8" data-grupo>
			<div class="flex flex-wrap items-center gap-x-5 gap-y-3">
				<MenuDesplegable titulo={l.linea || 'Sin subtítulo'} apagado={!l.linea} actual={l.id} opciones={opciones} />
				<button
					type="button"
					class="flex items-center gap-1.5 rounded-md bg-marca px-4 py-2 text-sm font-bold text-white transition hover:bg-oro-oscuro"
					data-abrir="dialogo-grupo"
					data-titulo="Editar la línea"
					data-valores={JSON.stringify({
						accion: 'renombrar',
						grupo: l.id,
						seccion,
						nombre: l.linea,
						tituloNueva: `Nueva línea de ${seccion === 'ataudes' ? 'ataúdes' : 'urnas'}`,
						tituloBorrar: `¿Seguro que deseas borrar «${l.linea || 'Sin subtítulo'}»?`,
						avisoBorrar: avisoBorrarGrupo(l.productos.length, 'la línea'),
					})}
				>
					<Icono nombre="Pencil" class="size-4" /> Editar
				</button>
				<BotonAgregar texto={`Agregar ${tipo}`} dialogo="dialogo-producto" valores={{ grupo: l.id, id: '', especificaciones: [] }} />
			</div>
			<ul class="mt-6 grid gap-3" data-paginar>
				{l.productos.map((p) => (
					<FilaAdmin
						nombre={p.nombre}
						foto={p.foto}
						editar={{
							dialogo: 'dialogo-producto',
							titulo: `Editar ${tipo}`,
							valores: { grupo: l.id, id: p.id, nombre: p.nombre, foto: p.foto, especificaciones: p.especificaciones },
						}}
						borrar={{ grupo: l.id, id: p.id }}
					/>
				))}
			</ul>
		</div>
	))}

	{lineas.length === 0 && <BotonAgregar
		texto={seccion === 'ataudes' ? 'Agregar línea de ataúdes' : 'Agregar línea de urnas'}
		titulo="Nueva línea"
		dialogo="dialogo-grupo"
		valores={{ accion: 'crear-grupo', grupo: '', seccion, nombre: '' }}
		descripcion={`Crea un nuevo subtítulo de ${seccion === 'ataudes' ? 'ataúdes' : 'urnas'} con sus propias tarjetas.`}
	/>}
</div>
