---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-color.webp';
import { navegacion, sitio } from '../data/sitio';

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---

<header class="relative z-40">
	<!-- Franja superior: atención 24 h -->
	<div class="bg-ciruela text-sm text-white">
		<div class="mx-auto flex max-w-7xl items-center justify-center gap-x-6 px-4 py-2 sm:justify-between">
			<p class="flex items-center gap-2">
				<span class="relative flex size-2">
					<span class="absolute inline-flex size-full animate-ping rounded-full bg-oro opacity-75 motion-reduce:animate-none"></span>
					<span class="relative inline-flex size-2 rounded-full bg-oro"></span>
				</span>
				<span><strong class="font-bold">Atención 24 horas</strong>, los 365 días del año</span>
			</p>
			<div class="hidden items-center gap-5 sm:flex">
				<a href={sitio.whatsapp.href} class="text-white/90 hover:text-white" target="_blank" rel="noopener">WhatsApp {sitio.whatsapp.mostrar}</a>
				<a href={sitio.facebook} class="text-white/90 hover:text-white" target="_blank" rel="noopener" aria-label="Facebook">
					<svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9Z" /></svg>
				</a>
			</div>
		</div>
	</div>

	<!-- Logo y llamada -->
	<div class="bg-white">
		<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 lg:py-4">
			<a href="/" class="shrink-0" aria-label="Funerales González, ir al inicio">
				<Image src={logo} alt="Funerales González" class="h-14 w-auto lg:h-20" loading="eager" />
			</a>

			<a href={sitio.telefono.href} class="ml-auto hidden items-center gap-3 rounded-lg px-3 py-2 text-marca hover:bg-humo md:flex">
				<span class="grid size-11 place-items-center rounded-full bg-oro-oscuro text-white">
					<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5.5C3 14 10 21 18.5 21a2 2 0 0 0 2-2v-2.3a1 1 0 0 0-.7-1l-3.5-1.1a1 1 0 0 0-1 .3l-1.4 1.6a12 12 0 0 1-5.4-5.4l1.6-1.4a1 1 0 0 0 .3-1L9.3 4.2a1 1 0 0 0-1-.7H5a2 2 0 0 0-2 2Z" /></svg>
				</span>
				<span class="leading-tight">
					<span class="block text-xs font-semibold tracking-wider uppercase">Llámanos ahora</span>
					<span class="block font-serif text-xl font-semibold text-ciruela">{sitio.telefono.mostrar}</span>
				</span>
			</a>

			<button
				type="button"
				class="grid size-11 place-items-center rounded-md text-ciruela hover:bg-humo xl:hidden"
				aria-controls="menu-movil"
				aria-expanded="false"
				data-menu-boton
			>
				<span class="sr-only">Abrir menú</span>
				<svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" data-icono-abrir><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
				<svg class="hidden size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" data-icono-cerrar><path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" /></svg>
			</button>
		</div>
	</div>

	<!-- Navegación de escritorio -->
	<nav class="hidden bg-marca xl:block" aria-label="Principal">
		<ul class="mx-auto flex max-w-7xl items-stretch justify-between px-2">
			{navegacion.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={activo(item.href) ? 'page' : undefined}
						class="relative block px-3 py-3.5 text-[0.9375rem] font-semibold whitespace-nowrap text-white/90 transition-colors hover:bg-black/15 hover:text-white aria-[current=page]:bg-black/20 aria-[current=page]:text-white after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:scale-x-0 after:bg-oro after:transition-transform hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
					>
						{item.texto}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<!-- Navegación móvil -->
	<nav id="menu-movil" class="hidden border-t border-black/5 bg-white shadow-lg xl:hidden" aria-label="Principal" data-menu-panel>
		<ul class="mx-auto max-w-7xl divide-y divide-black/5 px-4 py-2">
			{navegacion.map((item) => (
				<li>
					<a
						href={item.href}
						aria-current={activo(item.href) ? 'page' : undefined}
						class="block py-3 text-lg font-semibold text-ciruela aria-[current=page]:text-oro-oscuro"
					>
						{item.texto}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<script>
	const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
	const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
	boton?.addEventListener('click', () => {
		const abierto = boton.getAttribute('aria-expanded') === 'true';
		boton.setAttribute('aria-expanded', String(!abierto));
		boton.querySelector('.sr-only')!.textContent = abierto ? 'Abrir menú' : 'Cerrar menú';
		boton.querySelector('[data-icono-abrir]')?.classList.toggle('hidden', !abierto);
		boton.querySelector('[data-icono-cerrar]')?.classList.toggle('hidden', abierto);
		panel?.classList.toggle('hidden', abierto);
	});
</script>
