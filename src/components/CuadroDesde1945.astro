---
// Cuadro "Desde 1945" con los años de servicio; se usa en la portada y en Nosotros.
const anios = new Date().getFullYear() - 1945;
---

<div class="relative isolate overflow-hidden rounded-2xl bg-lavanda px-8 py-14 text-center">
	<!-- Cruz del logo, decorativa, asomando por el borde derecho -->
	<img src="/favicon_fg.png" alt="" width="512" height="512" loading="lazy" class="absolute inset-y-0 right-0 -z-10 h-full w-auto translate-x-1/2 opacity-25 sm:translate-x-1/3" />
	<p class="font-serif text-7xl font-semibold text-oro-oscuro sm:text-8xl">
		<span class="block text-3xl font-normal italic sm:text-4xl">Desde</span>
		1945
	</p>
	<p class="mt-2 text-sm font-bold tracking-[0.2em] text-marca uppercase">Una institución familiar</p>
	<div class="mx-auto mt-8 grid max-w-xs grid-cols-2 divide-x divide-marca/20">
		<div>
			<p class="font-serif text-4xl font-semibold text-ciruela">{anios}</p>
			<p class="text-sm text-marca">años de servicio</p>
		</div>
		<div>
			<p class="font-serif text-4xl font-semibold text-ciruela">3</p>
			<p class="text-sm text-marca">generaciones</p>
		</div>
	</div>
</div>
