---
// Separador ornamental: línea con una flor de lis en cada extremo, apuntando hacia afuera.
// Se coloca dentro de una sección con `relative` para montarse sobre su borde superior.
interface Props {
	class?: string;
}

const { class: clase = '' } = Astro.props;
---

<div class:list={['pointer-events-none flex items-center text-oro-oscuro', clase]} aria-hidden="true">
	<svg class="size-10 shrink-0 -rotate-90 sm:size-12" viewBox="0 0 24 24" fill="currentColor"><use href="#flor-de-lis" /></svg>
	<span class="-mx-1 h-[3px] flex-1 rounded-full bg-current"></span>
	<svg class="size-10 shrink-0 rotate-90 sm:size-12" viewBox="0 0 24 24" fill="currentColor"><use href="#flor-de-lis" /></svg>

	<svg class="hidden">
		<symbol id="flor-de-lis" viewBox="0 0 24 24">
			<!-- Pétalo central -->
			<path d="M12 1.5c-2.6 3-3.1 7.6-.6 12h1.2c2.5-4.4 2-9-.6-12Z" />
			<!-- Pétalos laterales que se enroscan hacia afuera -->
			<path d="M10.8 13.5C8 13.2 4.3 12 3.2 8.6c-.6-1.9 1.3-3.2 2.6-2 .4.4.2 1-.3 1.1-.9.1-.9 1.5.1 2 1.8.9 4.3 1.6 5.6 3.3Z" />
			<path d="M13.2 13.5c2.8-.3 6.5-1.5 7.6-4.9.6-1.9-1.3-3.2-2.6-2-.4.4-.2 1 .3 1.1.9.1.9 1.5-.1 2-1.8.9-4.3 1.6-5.6 3.3Z" />
			<!-- Banda -->
			<rect x="7" y="13.4" width="10" height="2" rx="1" />
			<!-- Pie -->
			<path d="M12 15.4c-.7 1.6-2 2.9-3.6 3.4.9.6 2.2.5 3 0l.6 3.7.6-3.7c.8.5 2.1.6 3 0-1.6-.5-2.9-1.8-3.6-3.4Z" />
		</symbol>
	</svg>
</div>
