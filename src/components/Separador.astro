---
// Separador ornamental: la paloma al centro, sobre un círculo blanco, y a cada lado, dos líneas doradas que se adelgazan hacia afuera.
// Se coloca dentro de una sección con `relative` para montarse sobre su borde superior.
interface Props {
	class?: string;
}

const { class: clase = '' } = Astro.props;
---

<div class:list={['pointer-events-none flex items-center gap-1.5 text-dorado sm:gap-2', clase]} aria-hidden="true" data-aparece="separador">
	<!-- Líneas: angostas en la orilla, más gruesas junto a la paloma. Las de la derecha son el espejo de las de la izquierda. -->
	<svg class="h-3 flex-1 sm:h-3.5" viewBox="0 0 100 10" preserveAspectRatio="none" fill="currentColor">
		<polygon points="0,4.2 100,0 100,4.2" />
		<polygon points="0,9.6 100,5.8 100,10" />
	</svg>
	<!-- Círculo blanco detrás de la paloma para que no la cruce el borde entre las dos secciones -->
	<span class="grid size-20 shrink-0 place-items-center rounded-full bg-white shadow-[0_4px_14px_rgb(0_0_0/0.08)] ring-1 ring-dorado/20 sm:size-24 lg:size-28">
		<img src="/icono_paloma.svg" alt="" width="155" height="96" class="h-auto w-12 sm:w-16 lg:w-20" />
	</span>
	<svg class="h-3 flex-1 -scale-x-100 sm:h-3.5" viewBox="0 0 100 10" preserveAspectRatio="none" fill="currentColor">
		<polygon points="0,4.2 100,0 100,4.2" />
		<polygon points="0,9.6 100,5.8 100,10" />
	</svg>
</div>
