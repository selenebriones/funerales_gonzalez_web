---
// Foto de la fachada de una sucursal; si aún no hay foto, muestra la paloma sobre lavanda.
interface Props {
	foto?: string;
	nombre: string;
	class?: string;
}

const { foto, nombre, class: clase = '' } = Astro.props;
---

{foto ? (
	<img src={foto} alt={`Fachada de ${nombre}`} loading="lazy" class:list={['object-cover', clase]} />
) : (
	<div class:list={['grid place-items-center bg-lavanda', clase]}>
		<img src="/icono_paloma.svg" alt="" width="155" height="96" loading="lazy" class="w-1/2 h-auto opacity-60" />
	</div>
)}
