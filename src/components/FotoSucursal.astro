---
// Foto de la fachada de una sucursal; si aún no hay foto, muestra la cruz del logo sobre lavanda.
interface Props {
	foto?: string;
	nombre: string;
	class?: string;
}

const { foto, nombre, class: clase = '' } = Astro.props;
---

{foto ? (
	<img src={foto} alt={`Fachada de ${nombre}`} loading="lazy" class:list={['object-cover', clase]} />
) : (
	<div class:list={['grid place-items-center bg-lavanda', clase]}>
		<img src="/favicon_fg.png" alt="" width="512" height="512" loading="lazy" class="h-3/5 w-auto opacity-40" />
	</div>
)}
