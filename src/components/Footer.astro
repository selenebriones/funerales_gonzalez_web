---
import Icono from './Icono.astro';
import { navegacion, sitio, sucursales } from '../data/sitio';

const matriz = sucursales[0];
---

<footer class="bg-ciruela text-white/80">
	<div class="border-b border-white/10">
		<div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-4 py-12 lg:flex-row lg:items-center">
			<p class="max-w-xl font-serif text-3xl leading-snug text-white">Estamos aquí para ti, en cualquier momento del día.</p>
			<div class="flex flex-wrap gap-3">
				<a href={sitio.telefono.href} class="inline-flex items-center gap-2 rounded-md bg-oro-claro px-5 py-3 font-bold text-ciruela hover:bg-white">
					<Icono nombre="Phone" class="size-5" /> {sitio.telefono.mostrar}
				</a>
				<a href={sitio.whatsapp.href} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-md px-5 py-3 font-bold text-white ring-1 ring-white/40 ring-inset hover:bg-white/10">
					<Icono nombre="MessageCircle" class="size-5" /> WhatsApp
				</a>
			</div>
		</div>
	</div>

	<div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-[2fr_2fr_1fr]">
		<div>
			<p class="font-serif text-xl text-white">{sitio.nombre}</p>
			<p class="mt-1 text-sm">{sitio.lema}</p>
			<dl class="mt-6 space-y-3 text-sm">
				<div class="flex gap-3">
					<dt><Icono nombre="MapPin" class="size-5 text-oro-claro" /><span class="sr-only">Dirección</span></dt>
					<dd>{matriz.nombre}<br />{matriz.direccion}</dd>
				</div>
				<div class="flex gap-3">
					<dt><Icono nombre="Phone" class="size-5 text-oro-claro" /><span class="sr-only">Teléfono</span></dt>
					<dd>{matriz.telefonos.join(' · ')}</dd>
				</div>
				<div class="flex gap-3">
					<dt><Icono nombre="Clock" class="size-5 text-oro-claro" /><span class="sr-only">Horario</span></dt>
					<dd>Atención 24/7 para urgencias</dd>
				</div>
			</dl>
		</div>

		<nav aria-label="Pie de página">
			<p class="text-sm font-bold tracking-[0.2em] text-oro-claro uppercase">Secciones</p>
			<ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
				{navegacion.map((item) => (
					<li><a href={item.href} class="text-white/80 hover:text-white">{item.texto}</a></li>
				))}
			</ul>
		</nav>

		<div>
			<p class="text-sm font-bold tracking-[0.2em] text-oro-claro uppercase">Síguenos</p>
			<a href={sitio.facebook} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 text-sm text-white/80 hover:text-white">
				<svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9Z" /></svg>
				Facebook
			</a>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-xs text-white/60 sm:flex-row sm:justify-between">
			<p>© {new Date().getFullYear()} {sitio.razonSocial}</p>
			<a href="/aviso-de-privacidad" class="text-white/60 hover:text-white">Aviso de privacidad</a>
		</div>
	</div>
</footer>
